{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@payload-config": ["./src/payload.config.ts"],
      "@payloadcms/next/importMap": ["./importMap.ts"]
    }
  },
  "include": ["src", "next-env.d.ts", ".next/types/**/*.ts", "importMap.ts"],
  "exclude": ["node_modules", "dist", ".next"]
}
