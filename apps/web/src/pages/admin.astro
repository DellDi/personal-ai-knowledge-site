---
import Card from '../components/Card.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, ui } from '../lib/i18n';

const t = ui[defaultLocale];
---

<BaseLayout locale={defaultLocale} title={t.adminTitle} description={t.adminIntro} canonicalPath="/admin" noindex>
  <section class="container admin-page">
    <SectionHeader title={t.adminTitle} description={t.adminIntro} />
    <div class="grid">
      <Card>
        <h2>信息架构预留</h2>
        <p>后续可扩展为运营首页、内容日历、集合编辑、审核队列、媒体库和系统设置。</p>
      </Card>
      <Card>
        <h2>首版边界</h2>
        <p>当前不接登录、不写入内容、不接 CMS，只保留后台管理的命名边界和设计空间。</p>
      </Card>
    </div>
  </section>
</BaseLayout>

<style>
  .admin-page {
    padding-block: clamp(42px, 8vw, 88px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
