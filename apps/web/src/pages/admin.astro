---
import { getCollection } from 'astro:content';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, ui } from '../lib/i18n';

const t = ui[defaultLocale];
const cmsURL = import.meta.env.CMS_API_URL ?? process.env.CMS_API_URL;
const cmsAdminURL = process.env.CMS_ADMIN_URL ?? 'http://localhost:3000/admin';

let postsCount = 0;
try {
  const posts = await getCollection('posts', ({ data }) => data.status === 'published');
  postsCount = posts.length;
} catch {
  postsCount = 0;
}

const modeLabel = cmsURL ? t.adminStatusModeCms : t.adminStatusModeLocal;
const modeTone: 'accent' | 'blue' = cmsURL ? 'accent' : 'blue';
---

<BaseLayout locale={defaultLocale} title={t.adminTitle} description={t.adminIntro} canonicalPath="/admin" noindex>
  <section class="container admin-page">
    <SectionHeader title={t.adminTitle} description={t.adminIntro} />

    <div class="grid">
      <Card>
        <h2>{t.adminCmsLink}</h2>
        <p>{t.adminCmsLinkHint}</p>
        <Button href={cmsAdminURL} variant="primary">{t.adminCmsLink}</Button>
      </Card>

      <Card>
        <h2>{t.adminStatusTitle}</h2>
        <dl class="status-list">
          <div>
            <dt>{t.adminStatusPosts}</dt>
            <dd><strong>{postsCount}</strong></dd>
          </div>
          <div>
            <dt>{t.adminStatusMode}</dt>
            <dd><Badge tone={modeTone}>{modeLabel}</Badge></dd>
          </div>
        </dl>
        <p class="guide">{t.adminStatusGuide}</p>
      </Card>
    </div>
  </section>
</BaseLayout>

<style>
  .admin-page {
    padding-block: clamp(42px, 8vw, 88px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  p {
    margin: 0 0 18px;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .guide {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .status-list {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .status-list > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  dt {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  strong {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
