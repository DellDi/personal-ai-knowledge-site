---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../../layouts/EntryLayout.astro';
import EntryNav from '../../../components/EntryNav.astro';
import { getKnowledgeNeighbors } from '../../../lib/content';
import type { Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({
    params: { locale: entry.data.lang, slug: entry.data.slug },
    props: { entry, locale: entry.data.lang },
  }));
}

const { entry, locale } = Astro.props as { entry: CollectionEntry<'knowledge'>; locale: Locale };
const { Content, headings } = await render(entry);
const neighbors = await getKnowledgeNeighbors(entry, locale);
---

<EntryLayout collection="knowledge" entry={entry} locale={locale} headings={headings}>
  <Content />
  <div slot="after-content">
    <EntryNav prev={neighbors.prev} next={neighbors.next} locale={locale} collection="knowledge" />
  </div>
</EntryLayout>
