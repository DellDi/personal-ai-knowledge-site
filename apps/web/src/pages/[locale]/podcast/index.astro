---
import Card from '../../../components/Card.astro';
import PodcastCard from '../../../components/PodcastCard.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../../../lib/content';
import { locales, ui, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const entries = await getPublishedEntries('podcast', locale);
const t = ui[locale];
---

<BaseLayout locale={locale} title={t.nav[1].label} description={t.podcastDescription} canonicalPath={`/${locale}/podcast`}>
  <section class="container page-section">
    <SectionHeader title={t.nav[1].label} description={t.podcastDescription} />
    <div class="grid">
      {entries.length > 0 ? entries.map((entry) => <PodcastCard entry={entry} locale={locale} />) : <Card>{t.empty}</Card>}
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-block: clamp(42px, 8vw, 88px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
