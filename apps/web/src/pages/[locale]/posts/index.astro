---
import ArticleCard from '../../../components/ArticleCard.astro';
import Card from '../../../components/Card.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../../../lib/content';
import { locales, ui, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const entries = await getPublishedEntries('posts', locale);
const t = ui[locale];
---

<BaseLayout locale={locale} title={t.nav[2].label} description="Technical essays, product notes, and engineering retrospectives." canonicalPath={`/${locale}/posts`}>
  <section class="container page-section">
    <SectionHeader title={t.nav[2].label} description="Long-form notes for architecture, AI agents, product systems, and practical engineering." />
    <div class="grid">
      {entries.length > 0 ? entries.map((entry) => <ArticleCard entry={entry} locale={locale} />) : <Card>{t.empty}</Card>}
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-block: clamp(42px, 8vw, 88px);
  }

  .grid {
    display: grid;
    gap: 20px;
  }
</style>
