---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../../layouts/EntryLayout.astro';
import BlockRenderer from '../../../components/docs/BlockRenderer.astro';
import type { Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({
    params: { locale: entry.data.lang, slug: entry.data.slug },
    props: { entry, locale: entry.data.lang },
  }));
}

const { entry, locale } = Astro.props as { entry: CollectionEntry<'posts'>; locale: Locale };
const { Content, headings } = await render(entry);
const blocks = entry.data.contentBlocks;
---

<EntryLayout collection="posts" entry={entry} locale={locale} headings={headings}>
  <Content />
  {blocks && blocks.length > 0 && <BlockRenderer blocks={blocks} />}
</EntryLayout>
