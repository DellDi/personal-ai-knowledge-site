---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, getLocalePath } from '../lib/i18n';
---

<BaseLayout locale={defaultLocale} title="404" description="Page not found." canonicalPath="/404" noindex>
  <section class="container not-found">
    <p>404</p>
    <h1>Page not found</h1>
    <Button href={getLocalePath(defaultLocale)}>返回首页</Button>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 55vh;
    display: grid;
    align-content: center;
    gap: 18px;
    padding-block: clamp(48px, 8vw, 96px);
  }

  p {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 12vw, 9rem);
    line-height: 0.88;
  }
</style>
