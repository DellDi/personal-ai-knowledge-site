---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import Tag from './Tag.astro';
import { formatDate, getEntryPath } from '../lib/content';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'posts'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
---

<Card href={getEntryPath('posts', entry)}>
  <article class="article-card">
    <p class="meta">{entry.data.category} / {formatDate(entry.data.date, locale)}</p>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.description}</p>
    <div class="tags">
      {entry.data.tags.map((tag) => <Tag tag={tag} locale={locale} />)}
    </div>
    <span class="read">{ui[locale].readMore}</span>
  </article>
</Card>

<style>
  .article-card {
    display: grid;
    gap: 14px;
  }

  .meta,
  .read {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
