---
import clsx from 'clsx';

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const classes = clsx('card hard-card', href && 'card-link focus-ring', className);
---

{href ? <a class={classes} href={href}><slot /></a> : <section class={classes}><slot /></section>}

<style>
  .card {
    display: block;
    padding: clamp(18px, 3vw, 28px);
  }

  .card-link {
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .card-link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 9px 0 var(--color-border);
  }
</style>
