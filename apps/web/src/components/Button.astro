---
import clsx from 'clsx';

type Variant = 'primary' | 'secondary' | 'quiet';

interface Props {
  href?: string;
  variant?: Variant;
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'primary', type = 'button' } = Astro.props;
const className = clsx('button focus-ring', `button-${variant}`);
---

{href ? <a class={className} href={href}><slot /></a> : <button class={className} type={type}><slot /></button>}

<style>
  .button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 14px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-hard-sm);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--color-border);
  }

  .button-primary {
    background: var(--color-accent);
    color: #111111;
  }

  .button-secondary {
    background: var(--color-accent-3);
    color: #111111;
  }

  .button-quiet {
    background: var(--color-surface);
    color: var(--color-ink);
  }
</style>
