---
import Badge from '../Badge.astro';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  source?: string;
}

const { src, alt, caption, source } = Astro.props;
---

<figure class="figure">
  <div class="figure-frame">
    <img src={src} alt={alt} loading="lazy" />
  </div>
  {(caption || source) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {source && <Badge>{source}</Badge>}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: 1.8rem 0;
  }

  .figure-frame {
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard-sm);
    overflow: hidden;
  }

  .figure-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }
</style>
