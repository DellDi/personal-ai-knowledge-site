---
interface Props {
  variant?: 'info' | 'tip' | 'warning' | 'danger';
  title?: string;
}

const { variant = 'info', title } = Astro.props;
const labels: Record<string, string> = {
  info: '说明',
  tip: '建议',
  warning: '注意',
  danger: '风险',
};
---

<aside class:list={['callout', `callout-${variant}`]} data-pagefind-ignore>
  <p class="callout-label">{title ?? labels[variant]}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.6rem 0;
    padding: 18px 20px;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard-sm);
  }

  .callout-label {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .callout-body {
    line-height: 1.65;
  }

  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .callout-info {
    border-left-width: 6px;
  }
  .callout-info .callout-label {
    color: var(--color-accent-2);
  }

  .callout-tip {
    border-left-width: 6px;
    border-left-color: var(--color-accent-3);
  }
  .callout-tip .callout-label {
    color: var(--color-ink);
  }
  .callout-tip .callout-body {
    background: color-mix(in srgb, var(--color-accent-3) 12%, transparent);
    margin: 0 -20px -18px;
    padding: 12px 20px 18px;
  }

  .callout-warning {
    border-left-width: 6px;
    border-left-color: var(--color-accent);
  }
  .callout-warning .callout-label {
    color: var(--color-accent);
  }

  .callout-danger {
    border-left-width: 6px;
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }
  .callout-danger .callout-label {
    color: var(--color-accent);
  }
</style>
