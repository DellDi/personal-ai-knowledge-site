---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title?: string;
}

const { headings, title = '本页目录' } = Astro.props;
const items = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
---

{items.length > 0 && (
  <aside class="toc">
    <p>{title}</p>
    <nav aria-label={title}>
      {items.map((heading) => (
        <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </nav>
  </aside>
)}

<style>
  .toc {
    position: sticky;
    top: 96px;
    align-self: start;
    padding: 16px;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  p {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  nav {
    display: grid;
    gap: 9px;
  }

  a {
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.3;
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .depth-3 {
    padding-left: 12px;
  }

  @media (max-width: 1080px) {
    .toc {
      position: static;
    }
  }
</style>
