---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import CardCover from './CardCover.astro';
import Tag from './Tag.astro';
import { getEntryPath } from '../lib/content';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = ui[locale];
const href = getEntryPath('projects', entry);
---

<Card>
  <article class="project-card">
    <a class="cover-link focus-ring" href={href} aria-label={entry.data.title}>
      <CardCover src={entry.data.cover} alt={entry.data.title} fallback={entry.data.title} />
    </a>
    <div class="content">
      <p>{entry.data.role ?? t.projectFallbackRole}</p>
      <h3><a class="title-link focus-ring" href={href}>{entry.data.title}</a></h3>
      <span>{entry.data.description}</span>
      <div class="stack">
        {entry.data.stack.map((item) => <strong>{item}</strong>)}
      </div>
      <div class="tags">
        {entry.data.tags.map((tag) => <Tag tag={tag} locale={locale} />)}
      </div>
    </div>
  </article>
</Card>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(120px, 34%) 1fr;
    gap: clamp(16px, 3vw, 28px);
  }

  .cover-link {
    display: block;
  }

  .content {
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
  }

  p {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    line-height: 1;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  span {
    color: var(--color-muted);
    line-height: 1.55;
  }

  .stack,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  strong {
    padding: 5px 8px;
    border: 1px solid var(--color-border);
    background: var(--color-accent-3);
    color: #111111;
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  @media (max-width: 520px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }
</style>
