---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import Tag from './Tag.astro';
import { getEntryPath } from '../lib/content';
import { type Locale } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'topics'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
---

<Card href={getEntryPath('topics', entry)}>
  <article class="topic-card">
    <p>{entry.data.items.length} linked items</p>
    <h3>{entry.data.title}</h3>
    <span>{entry.data.description}</span>
    <div>
      {entry.data.tags.map((tag) => <Tag tag={tag} locale={locale} />)}
    </div>
  </article>
</Card>

<style>
  .topic-card {
    display: grid;
    gap: 14px;
  }

  p {
    margin: 0;
    color: var(--color-accent-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 0.96;
  }

  span {
    color: var(--color-muted);
    line-height: 1.55;
  }

  div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
