---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import CardCover from './CardCover.astro';
import Tag from './Tag.astro';
import { getEntryPath } from '../lib/content';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'topics'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = ui[locale];
---

<Card href={getEntryPath('topics', entry)}>
  <article class="topic-card">
    <CardCover src={entry.data.hero} alt={entry.data.title} fallback={entry.data.title} />
    <div class="content">
      <p>{locale === 'zh-CN' ? `${entry.data.items.length} 个${t.topicLinkedItems}` : `${entry.data.items.length} ${t.topicLinkedItems}`}</p>
      <h3>{entry.data.title}</h3>
      <span>{entry.data.description}</span>
      <div>
        {entry.data.tags.map((tag) => <Tag tag={tag} locale={locale} />)}
      </div>
    </div>
  </article>
</Card>

<style>
  .topic-card {
    display: grid;
    grid-template-columns: minmax(120px, 34%) 1fr;
    gap: clamp(16px, 3vw, 28px);
  }

  .content {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  p {
    margin: 0;
    color: var(--color-accent-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 0.96;
  }

  span {
    color: var(--color-muted);
    line-height: 1.55;
  }

  div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 520px) {
    .topic-card {
      grid-template-columns: 1fr;
    }
  }
</style>
