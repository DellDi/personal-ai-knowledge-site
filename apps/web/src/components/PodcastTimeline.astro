---
import type { CollectionEntry } from 'astro:content';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'podcast'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = ui[locale];
const timeline = entry.data.timeline;
---

{timeline.length > 0 && (
  <section class="podcast-timeline" aria-label={t.podcastTimeline}>
    <p>{t.podcastTimeline}</p>
    <ol>
      {timeline.map((item) => (
        <li>
          <a class="timeline-row focus-ring" href={entry.data.audio} data-time={item.time}>
            <span class="timeline-time">{item.time}</span>
            <span class="timeline-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .podcast-timeline {
    margin-top: 36px;
    padding: 20px;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-hard-sm);
  }

  p {
    margin: 0 0 14px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
  }

  ol {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 14px;
    align-items: baseline;
    padding: 8px 10px;
    border: 1px solid transparent;
  }

  .timeline-row:hover {
    border-color: var(--color-border);
    background: var(--color-surface-strong);
  }

  .timeline-time {
    color: var(--color-accent-2);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .timeline-label {
    color: var(--color-ink);
    font-size: 0.94rem;
    line-height: 1.45;
  }
</style>
