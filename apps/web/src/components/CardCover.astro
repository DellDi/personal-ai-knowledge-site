---
interface Props {
  src?: string;
  alt?: string;
  fallback: string;
}

const { src, alt, fallback } = Astro.props;
---

<div class="cover">
  {src ? (
    <img src={src} alt={alt || fallback} loading="lazy" decoding="async" />
  ) : (
    <span class="cover-placeholder" aria-hidden="true">{fallback.slice(0, 1)}</span>
  )}
</div>

<style>
  .cover {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    padding: clamp(10px, 2vw, 18px);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-strong);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .cover-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 800;
    color: var(--color-text);
    text-transform: uppercase;
  }
</style>
