---
interface Props {
  tone?: 'accent' | 'blue' | 'neutral';
}

const { tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', `badge-${tone}`]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 4px 8px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1;
  }

  .badge-neutral {
    background: var(--color-surface-strong);
    color: var(--color-ink);
  }

  .badge-accent {
    background: var(--color-accent);
    color: #111111;
  }

  .badge-blue {
    background: var(--color-accent-2);
    color: #ffffff;
  }
</style>
