---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import Tag from './Tag.astro';
import { formatDate, getEntryPath } from '../lib/content';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'podcast'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
---

<Card href={getEntryPath('podcast', entry)}>
  <article class="podcast-card">
    <div class="topline">
      <Badge tone="accent">S{entry.data.season} EP{entry.data.episode}</Badge>
      <span>{formatDate(entry.data.date, locale)}</span>
    </div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.description}</p>
    <div class="tags">
      {entry.data.tags.map((tag) => <Tag tag={tag} locale={locale} />)}
    </div>
    <strong>{ui[locale].listen}</strong>
  </article>
</Card>

<style>
  .podcast-card {
    display: grid;
    gap: 14px;
  }

  .topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    line-height: 0.98;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  strong {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
