---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import CardCover from './CardCover.astro';
import Tag from './Tag.astro';
import { formatDate, getEntryPath } from '../lib/content';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'podcast'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const href = getEntryPath('podcast', entry);
---

<Card>
  <article class="podcast-card">
    <a class="cover-link focus-ring" href={href} aria-label={entry.data.title}>
      <CardCover src={entry.data.cover} alt={entry.data.title} fallback={entry.data.title} />
    </a>
    <div class="content">
      <div class="topline">
        <Badge tone="accent">S{entry.data.season} EP{entry.data.episode}</Badge>
        <span>{formatDate(entry.data.date, locale)}</span>
      </div>
      <h3><a class="title-link focus-ring" href={href}>{entry.data.title}</a></h3>
      <p>{entry.data.description}</p>
      <div class="tags">
        {entry.data.tags.map((tag) => <Tag tag={tag} locale={locale} />)}
      </div>
      <a class="listen focus-ring" href={href}>{ui[locale].listen}</a>
    </div>
  </article>
</Card>

<style>
  .podcast-card {
    display: grid;
    grid-template-columns: minmax(120px, 34%) 1fr;
    gap: clamp(16px, 3vw, 28px);
  }

  .cover-link {
    display: block;
  }

  .content {
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
  }

  .topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    line-height: 0.98;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .listen {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .listen:hover {
    color: var(--color-accent-2);
  }

  @media (max-width: 520px) {
    .podcast-card {
      grid-template-columns: 1fr;
    }
  }
</style>
