# Copy this file to infra/env/production.env on the server and replace every CHANGE_ME value.
# Do not commit production.env.

POSTGRES_DB=content_platform
POSTGRES_USER=content
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URI=postgres://content:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/content_platform

PAYLOAD_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
PAYLOAD_ENABLE_AUTOLOGIN=false
# 使用域名时改为 https://cms.yourdomain.com
PAYLOAD_PUBLIC_SELF_PATH=http://your-server-ip:3000
PAYLOAD_PUBLIC_SERVER_URL=http://your-server-ip:3000
# 使用域名时改为 https://yourdomain.com,https://cms.yourdomain.com
PAYLOAD_CORS_ORIGINS=http://your-server-ip:8080,http://your-server-ip:3000
PAYLOAD_CSRF_ORIGINS=http://your-server-ip:8080,http://your-server-ip:3000

# Astro web runtime / build.
CMS_API_URL=http://cms:3000/api
# 使用域名时改为 https://cms.yourdomain.com/admin
CMS_ADMIN_URL=http://your-server-ip:3000/admin
# Required when draft preview must read non-public CMS content.
CMS_API_TOKEN=CHANGE_ME_PAYLOAD_JWT_OR_SERVICE_TOKEN
# Host Node rebuild webhook. The cms container resolves host.docker.internal via docker-compose.
REBUILD_WEBHOOK_URL=http://host.docker.internal:4000/hooks/rebuild-personal-site
REBUILD_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_REBUILD_WEBHOOK_TOKEN
# Direct container-to-host calls require the host webhook to listen beyond loopback.
# If you use Nginx on the host to proxy deploy.example.com -> 127.0.0.1:4000, set this back to 127.0.0.1.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=4000
WEBHOOK_BUILD_TIMEOUT_SECONDS=1200

# Aliyun OSS. Use a production bucket, not the local MinIO bucket.
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_REGION=oss-cn-hangzhou
S3_BUCKET=CHANGE_ME_OSS_BUCKET
S3_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_OSS_ACCESS_KEY_SECRET
S3_FORCE_PATH_STYLE=false
