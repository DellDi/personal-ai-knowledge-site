# 本地部署配置模板
# 复制为 deploy.env 后填写真实值：cp infra/env/deploy.example.env infra/env/deploy.env
# deploy.env 已被 .gitignore 忽略，不会进入版本库。

# SSH Host 别名，复用 ~/.ssh/config 中已配置的 Host。
# 例如 ~/.ssh/config 里有：
#   Host mysite
#     HostName 1.2.3.4
#     User deploy
#     IdentityFile ~/.ssh/id_ed25519
# 则这里填 mysite，脚本会执行 ssh mysite ... / rsync ... mysite:...
DEPLOY_SSH_HOST=mysite

# 项目内 SSH 客户端配置路径（相对项目根目录或绝对路径）。
# 脚本会通过 ssh -F / rsync -e "ssh -F" 引用，不依赖全局 ~/.ssh/config。
# 从 infra/env/ssh_config.example 复制为 ssh_config 后填写。
# 若该文件不存在，脚本回退到 ~/.ssh/config。
DEPLOY_SSH_CONFIG=infra/env/ssh_config

# 服务器上项目根目录的绝对路径。
# rsync 会把本地源码同步到该目录，SSH 命令也会先 cd 到这里。
DEPLOY_PROJECT_DIR=/home/deploy/personal-ai-knowledge-site

# 服务器上 docker compose 使用的 compose 文件相对路径（相对项目根目录）。
DEPLOY_COMPOSE_FILE=infra/docker-compose.prod.yml

# 单步命令超时（秒）。构建可能较慢，默认 1800s = 30 分钟。
DEPLOY_STEP_TIMEOUT=1800

# 说明：
# - rsync 排除 node_modules / dist / .git / .astro / .cache / coverage / .env* / infra/env/*.env
#   服务器的 infra/env/production.env 不会被覆盖，由服务器自行维护。
# - 首次部署前请确保服务器上该目录已存在（rsync 会自动创建子目录结构，但父目录需存在）。
# - Windows 本地需有 rsync：Git Bash 自带，或通过 WSL / scoop install rsync 获取。
